{
  "name": "@vision2code/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @vision2code/contracts",
    "pretypecheck": "npm run build --workspace @vision2code/contracts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@vision2code/contracts": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
