# Public desktop configuration.
# Security notice:
# - Service-role keys must NEVER exist in the desktop/client.
# - A backend may use a service-role credential for legitimate privileged server-only operations in future.
# - Vision2Code does NOT need or use a service-role key for authentication or JWT verification.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase Auth public configuration (Publishable / Anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub_placeholder
