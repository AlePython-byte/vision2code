PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Supabase Auth configuration (for asymmetric JWKS verification).
# Security notice:
# - Service-role keys must NEVER exist in the desktop/client.
# - A backend may use a service-role credential for legitimate privileged server-only operations in future.
# - Vision2Code does NOT need or use a service-role key for authentication or JWT verification.
SUPABASE_URL=https://your-project.supabase.co

# Database Connection (PostgreSQL / Supabase)
# For Prisma schema migrations (DDL), a direct connection (port 5432) or Session pooler is required.
# Direct connection (recommended for dev & migrations):
#   postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Connection pooler (port 6543, for serverless/pooled runtime environments):
#   postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
