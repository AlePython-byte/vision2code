PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional per-mode analysis profile overrides (MODE = FAST, BALANCED, PRECISE). Unset uses the defaults in
# server/src/analysis/analysis-profiles.ts. Values beyond the hard caps in code are clamped:
# nodes 3-60, max output tokens 2000-20000, reasoning low|medium|high, image detail low|auto|high.
# ANALYSIS_PRECISE_NODES_MIN=30
# ANALYSIS_PRECISE_NODES_MAX=50
# ANALYSIS_PRECISE_IMAGE_DETAIL=high
# ANALYSIS_PRECISE_REASONING_EFFORT=medium
# ANALYSIS_PRECISE_MAX_OUTPUT_TOKENS=14000

# Optional shorter server deadline per mode, in seconds (MODE = FAST, BALANCED, PRECISE). It can only shorten
# the built-in deadline (fast 120, balanced 180, precise 300; floor 5), never extend it. Handy to provoke a timeout locally.
# ANALYSIS_PRECISE_TIMEOUT_SECONDS=20

# Optional per-user analysis limit (server/src/analysis/analysis-quota.ts). Cost units per sliding hour
# (1 unit = 1,000 tokens of a mode's output cap: fast 6, balanced 10, precise 14), analyses in flight at
# once, and users tracked in memory. Values beyond the hard caps are clamped: units 20-2000,
# concurrent 1-4, users 100-100000. The counter is per process and restarts with the server.
# ANALYSIS_QUOTA_UNITS_PER_HOUR=160
# ANALYSIS_QUOTA_MAX_CONCURRENT=2
# ANALYSIS_QUOTA_MAX_USERS=10000

# Supabase Auth configuration (for asymmetric JWKS verification).
# Security notice:
# - Service-role keys must NEVER exist in the desktop/client.
# - A backend may use a service-role credential for legitimate privileged server-only operations in future.
# - Vision2Code does NOT need or use a service-role key for authentication or JWT verification.
SUPABASE_URL=https://your-project.supabase.co

# Database Connection (PostgreSQL / Supabase)
# For Prisma schema migrations (DDL), a direct connection (port 5432) or Session pooler is required.
# Direct connection (recommended for dev & migrations):
#   postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Connection pooler (port 6543, for serverless/pooled runtime environments):
#   postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
