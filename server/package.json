{
  "name": "@vision2code/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start",
    "prebuild": "npm run build --workspace @vision2code/contracts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && tsc --project tsconfig.test.json && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@vision2code/contracts": "0.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
